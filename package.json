{
  "name": "ait-turncal",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:tz": "cross-env TZ=Asia/Seoul vitest run && cross-env TZ=America/New_York vitest run && cross-env TZ=UTC vitest run",
    "build": "tsc --noEmit && vite build && ait build",
    "build:adtest": "tsc --noEmit && vite build --mode adtest && ait build",
    "preview": "vite preview",
    "deploy": "ait deploy"
  },
  "devDependencies": {
    "@apps-in-toss/devtools": "3.9.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "6.0.0",
    "cross-env": "^10.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@apps-in-toss/web-framework": "3.9.0",
    "@emotion/react": "^11.14.0",
    "@toss/tds-mobile": "2.4.1",
    "@toss/tds-mobile-ait": "2.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
